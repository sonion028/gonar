{
  "name": "@tonar/vue-kit",
  "version": "0.0.1",
  "private": false,
  "description": "@tonar/vue-kit: A modern frontend library offering utility functions, Vue composables, and components with TypeScript support, ESM only, and tree-shaking capabilities.",
  "keywords": [
    "components",
    "hooks",
    "vue"
  ],
  "bugs": "https://github.com/sonion028/gonar/issues",
  "license": "MIT",
  "author": "sonion",
  "repository": "https://github.com/sonion028/gonar",
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "types": "./dist/types/index.d.ts"
    },
    "./composables": {
      "import": "./dist/composables.esm.js",
      "types": "./dist/types/composables.d.ts"
    },
    "./components": {
      "import": "./dist/components.esm.js",
      "types": "./dist/types/components.d.ts"
    }
  },
  "scripts": {
    "build": "rimraf dist && vite build"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "vue": "^3.5.38"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  }
}
