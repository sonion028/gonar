{
  "name": "@tonar/vue-kit",
  "version": "0.0.1-canary",
  "private": false,
  "description": "@tonar/vue-kit: Vue 3 ESM toolkit with permission-based rendering components such as SoAuthority.",
  "keywords": [
    "components",
    "composables",
    "vue"
  ],
  "bugs": "https://github.com/sonion028/gonar/issues",
  "license": "MIT",
  "author": "sonion",
  "repository": "https://github.com/sonion028/gonar",
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "types": "./dist/types/index.d.ts"
    },
    "./composables": {
      "import": "./dist/composables.esm.js",
      "types": "./dist/types/composables/index.d.ts"
    },
    "./components": {
      "import": "./dist/components.esm.js",
      "types": "./dist/types/components/index.d.ts"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest --run",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@tonar/utils": "workspace:*"
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "unplugin-vue": "^7.2.0",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.7"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  }
}
