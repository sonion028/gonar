{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // vue 必须
    "jsx": "preserve",
    "jsxImportSource": "vue",
    // 增量编译缓存位置
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    /* 路径别名 */
    "paths": {
      "@/*": ["./src/*"],
      "@gonar/utils": ["../utils/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
