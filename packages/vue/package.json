{
  "name": "@tonar/vue",
  "version": "0.0.1",
  "private": false,
  "description": "@tonar/vue: A modern frontend library offering utility functions, Vue composables, and components with TypeScript support, ESM only, and tree-shaking capabilities.",
  "keywords": [
    "components",
    "composables",
    "utils",
    "vue"
  ],
  "bugs": "https://github.com/sonion028/gonar/issues",
  "license": "MIT",
  "author": "sonion",
  "repository": "https://github.com/sonion028/gonar",
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "scripts": {
    "build": "rimraf dist && vite build"
  },
  "dependencies": {
    "@tonar/utils": "workspace:*",
    "@tonar/vue-kit": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  }
}
