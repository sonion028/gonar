{
  "name": "@tonar/utils",
  "version": "0.0.1-canary",
  "private": false,
  "description": "@tonar/utils: Framework-agnostic TypeScript utilities for async control, events, object conversion, browser downloads, XHR-based fetch, and animation-frame timers.",
  "keywords": [
    "utils"
  ],
  "bugs": "https://github.com/sonion028/gonar/issues",
  "license": "MIT",
  "author": "sonion",
  "repository": "https://github.com/sonion028/gonar",
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "dist/index.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest --run",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  }
