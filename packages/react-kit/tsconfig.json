{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    /* JSX */
    "jsx": "react-jsx",
    // 增量编译缓存位置
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    /* 路径别名 */
    "paths": {
      "@/*": ["./src/*"],
      "@tonar/*": ["../*/src"]
    }
  },
  "include": ["src", "types"]
}
