{
  "name": "@gonar/react",
  "version": "0.0.1",
  "private": false,
  "description": "Gonar: A modern frontend library offering utility functions, React hooks, and components with TypeScript support, ESM only, and tree-shaking capabilities.",
  "keywords": [
    "components",
    "hooks",
    "react"
  ],
  "bugs": {
    "url": "https://github.com/sonion028/gonar/issues"
  },
  "license": "MIT",
  "author": "sonion",
  "repository": "https://github.com/sonion028/gonar",
  "type": "module",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "types": "./dist/types/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks.esm.js",
      "types": "./dist/types/hooks.d.ts"
    },
    "./components": {
      "import": "./dist/components.esm.js",
      "types": "./dist/types/components.d.ts"
    }
  },
  "scripts": {
    "build": "rimraf dist && vite build"
  },
  "dependencies": {
    "@gonar/utils": "workspace:*"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.8.7",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint-plugin-react-refresh": "^0.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass-embedded": "^1.100.0",
    "vite-plugin-lib-inject-css": "^2.2.2"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=10.33.4",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.15.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
