{
  "name": "@tonar/react",
  "version": "0.0.1-canary",
  "private": false,
  "description": "@tonar/react: Tonar entry for React applications with React components, hooks, and general utilities.",
  "keywords": [
    "components",
    "hooks",
    "react",
    "utils"
  ],
  "bugs": "https://github.com/sonion028/gonar/issues",
  "license": "MIT",
  "author": "sonion",
  "repository": "https://github.com/sonion028/gonar",
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "types": "./dist/types/index.d.ts"
    },
    "./components": {
      "import": "./dist/components.esm.js",
      "types": "./dist/types/components/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks.esm.js",
      "types": "./dist/types/hooks/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.esm.js",
      "types": "./dist/types/utils/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@tonar/react-kit": "workspace:*",
    "@tonar/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  }
}
