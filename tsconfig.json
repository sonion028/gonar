{
  "compilerOptions": {
    "types": ["rolldown"],

    /* 目标与模块 */
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    /* JSX */
    "jsx": "react-jsx",

    /* 模块解析：现代 bundler 模式 */
    "moduleResolution": "bundler", // 更适合 Vite/Rollup
    "verbatimModuleSyntax": true, // 保持模块语法，不自动修改。区分类型导入和值导入。
    "moduleDetection": "force", // 强制检测模块，避免在非模块上下文使用模块语法
    "noEmit": true, // 不生成类型文件，库开发不需要
    "allowImportingTsExtensions": true, // 仅onEmit有效，允许.ts/.tsx 后缀导入。

    /* 严格检查与 lint */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": true,
    "useDefineForClassFields": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,
    "noImplicitThis": true, // 对 `this` 上的数据属性启用更严格的推断。
    "libReplacement": false, // 禁止三方库提替换lib声明。

    /* 互操作与工具支持 */
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    // "baseUrl": ".", // 已废弃，使用 paths 替代
    /* 路径别名 */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "types"],
  "exclude": ["node_modules", "dist"]
}
