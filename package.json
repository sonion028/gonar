{
  "name": "gonar",
  "version": "0.0.1",
  "private": true,
  "description": "Gonar: A modern frontend library offering utility functions, React hooks, and components with TypeScript support, ESM only, and tree-shaking capabilities.",
  "bugs": "https://github.com/sonion028/gonar/issues",
  "license": "MIT",
  "author": "sonion",
  "repository": "https://github.com/sonion028/gonar",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --stream run build",
    "tsc": "pnpm -r exec tsc --noEmit",
    "lint": "eslint '{src,apps,packages}/**/*.{ts,tsx,js,jsx,vue}'",
    "lint:fix": "eslint '{src,apps,packages}/**/*.{ts,tsx,js,jsx,vue}' --fix",
    "lint:error": "eslint '{src,apps,packages}/**/*.{ts,tsx,js,jsx,vue}' --quiet",
    "lint:spell": "cspell lint '{src,apps,packages}/**/*.{js,ts,jsx,tsx,mjs,cjs,json,css,less,scss,vue,html,md}'",
    "fmt": "oxfmt '{src,apps,packages}/**/*.*'",
    "fmt:check": "oxfmt --check '{src,apps,packages}/**/*.*'",
    "check": "pnpm run tsc && pnpm run lint && pnpm run fmt:check && pnpm run lint:spell",
    "fix": "pnpm run lint:fix && pnpm run fmt",
    "preinstall": "pnpm exec sync-node-version",
    "postinstall": "pnpm -r exec rimraf .node-version && pnpm -r --filter './{apps,packages}/*' pkg delete engines",
    "prepare": "pnpm exec simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint-react/eslint-plugin": "^5.8.19",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "cspell": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.50.0",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "sync-node-version": "^0.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "unplugin-dts": "^1.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.4.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.15.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
