{
  "name": "tonar",
  "version": "0.0.1",
  "private": true,
  "description": "Tonar: A TypeScript-first ESM monorepo for framework-agnostic utilities plus React and Vue UI toolkits.",
  "bugs": "https://github.com/sonion028/gonar/issues",
  "license": "MIT",
  "author": "sonion",
  "repository": "https://github.com/sonion028/gonar",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clear": "pnpm -r exec rimraf {node_modules,dist,.turbo} && pnpm exec rimraf {node_modules,dist,.turbo}",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint apps/*/src packages/*/src",
    "lint-all": "oxlint apps packages",
    "lint:fix": "oxlint --fix apps/*/src packages/*/src",
    "lint:error": "oxlint --quiet apps/*/src packages/*/src",
    "cspell": "cspell lint '{apps,packages}/**/*.{js,ts,jsx,tsx,mjs,cjs,json,css,less,scss,vue,html,md}'",
    "fmt": "oxfmt '{apps,packages}/**/*.*'",
    "fmt:check": "oxfmt --check '{apps,packages}/**/*.*'",
    "check": "turbo run typecheck && pnpm run lint && pnpm run fmt:check && pnpm run cspell",
    "fix": "pnpm run lint:fix && pnpm run fmt",
    "preinstall": "pnpm dlx sync-node-version",
    "postinstall": "pnpm -r exec rimraf .node-version && pnpm -F \"./{apps,packages}/*\" pkg delete engines && pnpm peers check",
    "prepare": "pnpm exec simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^24.19.2",
    "cspell": "^10.4.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "rimraf": "^6.1.4",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.22.14",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.18.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.22.3",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
