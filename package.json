{
  "name": "gonar",
  "version": "0.0.1",
  "private": false,
  "description": "Gonar: A modern frontend library offering utility functions, React hooks, and components with TypeScript support, ESM only, and tree-shaking capabilities.",
  "keywords": [
    "components",
    "hooks",
    "react",
    "utils"
  ],
  "bugs": {
    "url": "https://github.com/sonion028/gonar/issues"
  },
  "license": "MIT",
  "author": "sonion",
  "repository": "https://github.com/sonion028/gonar",
  "type": "module",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "types": "./dist/types/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.esm.js",
      "types": "./dist/types/utils.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks.esm.js",
      "types": "./dist/types/hooks.d.ts"
    },
    "./components": {
      "import": "./dist/components.esm.js",
      "types": "./dist/types/components.d.ts"
    }
  },
  "scripts": {
    "build": "rimraf dist && rolldown -c rolldown.config.ts",
    "preinstall": "npm run sync:node-version && (npx -y only-allow pnpm || exit 1)",
    "prepare": "npx simple-git-hooks",
    "sync:node-version": "node scripts/sync-node-version/index.js",
    "lint": "eslint '{src,apps,packages}/**/*.{ts,tsx,js,jsx,vue}'",
    "lint:fix": "eslint '{src,apps,packages}/**/*.{ts,tsx,js,jsx,vue}' --fix",
    "lint:error": "eslint '{src,apps,packages}/**/*.{ts,tsx,js,jsx,vue}' --quiet",
    "lint:spell": "cspell lint '{src,apps,packages}/**/*.{js,ts,jsx,tsx,mjs,cjs,json,css,less,scss,vue,html,md}'",
    "fmt": "oxfmt '{src,packages,apps}/**/*.*'",
    "fmt:check": "oxfmt --check '{src,packages,apps}/**/*.*'",
    "check": "npx tsc --noEmit && npm run lint && npm run fmt:check && npm run lint:spell",
    "fix": "npm run lint:fix && npm run fmt"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript/native-preview": "7.0.0-dev.20260329.1",
    "cspell": "^9.8.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "lightningcss": "^1.32.0",
    "lint-staged": "^16.4.0",
    "only-allow": "^1.2.2",
    "oxfmt": "^0.42.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.3",
    "rolldown": "1.0.0-rc.10",
    "rolldown-plugin-css": "^0.1.10",
    "rolldown-plugin-dts": "^0.22.5",
    "sass-embedded": "^1.99.0",
    "simple-git-hooks": "^2.13.1",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.3"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=10.32.1"
  }
}
