{
  "name": "tonar",
  "version": "0.0.1-canary",
  "private": true,
  "description": "Tonar: A TypeScript-first ESM monorepo for framework-agnostic utilities plus React and Vue UI toolkits.",
  "bugs": "https://github.com/sonion028/gonar/issues",
  "license": "MIT",
  "author": "sonion",
  "repository": "https://github.com/sonion028/gonar",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clear": "pnpm -r exec rimraf {node_modules,dist,.turbo} && pnpm exec rimraf {node_modules,dist,.turbo}",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "tlint": "oxlint --type-aware apps/*/src packages/*/src",
    "lint": "oxlint --type-aware apps packages",
    "lint:fix": "oxlint --type-aware --fix apps packages",
    "lint:error": "oxlint --type-aware --quiet apps packages",
    "cspell": "cspell lint '{apps,packages}/**/*.{js,ts,jsx,tsx,mjs,cjs,json,css,less,scss,vue,html,md}'",
    "fmt": "oxfmt '{apps,packages}/**/*.*'",
    "fmt:check": "oxfmt --check '{apps,packages}/**/*.*'",
    "check": "turbo run typecheck && pnpm run lint && pnpm run fmt:check && pnpm run cspell",
    "fix": "pnpm run lint:fix && pnpm run fmt",
    "preinstall": "pnpm exec sync-node-version",
    "postinstall": "pnpm -r exec rimraf .node-version && pnpm -F './{apps,packages}/*' pkg delete engines",
    "prepare": "pnpm exec simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tsdown/css": "^0.22.4",
    "@types/node": "^24.13.3",
    "cspell": "^10.0.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "sync-node-version": "^0.1.0",
    "tsdown": "^0.22.4",
    "turbo": "^2.10.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.4.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.15.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
