{
  "name": "gonar",
  "version": "0.0.1",
  "private": false,
  "description": "Gonar: A modern frontend library offering utility functions, React hooks, and components with TypeScript support, ESM only, and tree-shaking capabilities.",
  "keywords": [
    "components",
    "hooks",
    "react",
    "utils"
  ],
  "bugs": "https://github.com/sonion028/gonar/issues",
  "license": "MIT",
  "author": "sonion",
  "repository": "https://github.com/sonion028/gonar",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "module": "dist/index.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "types": "./dist/types/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.es.js",
      "types": "./dist/types/utils.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks.es.js",
      "types": "./dist/types/hooks.d.ts"
    },
    "./components": {
      "import": "./dist/components.es.js",
      "types": "./dist/types/components.d.ts"
    }
  },
  "scripts": {
    "build": "rimraf dist && rolldown -c rolldown.config.ts",
    "lint": "oxlint src",
    "lint:fix": "oxlint  --fix src",
    "lint:error": "oxlint --quiet src",
    "cspell": "cspell lint 'src/**/*.{js,ts,jsx,tsx,mjs,cjs,json,css,less,scss,vue,html,md}'",
    "fmt": "oxfmt 'src/**/*.*'",
    "fmt:check": "oxfmt --check 'src/**/*.*'",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check && pnpm run cspell",
    "fix": "pnpm run lint:fix && pnpm run fmt",
    "typecheck": "pnpm exec tsc --noEmit",
    "test": "vitest --run",
    "preinstall": "node scripts/sync-node-version/index.js",
    "prepare": "pnpm exec simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@testing-library/react": "^16.3.2",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "cspell": "^10.0.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.0",
    "rolldown-plugin-css": "^0.2.11",
    "rolldown-plugin-dts": "0.27.14",
    "simple-git-hooks": "^2.13.1",
    "sync-node-version": "^0.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.8.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.15.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
