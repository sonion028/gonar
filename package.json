{
  "name": "gonar",
  "version": "0.0.1",
  "private": false,
  "description": "Gonar: A modern frontend library offering utility functions, React hooks, and components with TypeScript support, ESM only, and tree-shaking capabilities.",
  "keywords": [
    "components",
    "hooks",
    "react",
    "utils"
  ],
  "bugs": "https://github.com/sonion028/gonar/issues",
  "license": "MIT",
  "author": "sonion",
  "repository": "https://github.com/sonion028/gonar",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "types": "./dist/types/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.esm.js",
      "types": "./dist/types/utils.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks.esm.js",
      "types": "./dist/types/hooks.d.ts"
    },
    "./components": {
      "import": "./dist/components.esm.js",
      "types": "./dist/types/components.d.ts"
    }
  },
  "scripts": {
    "build": "rimraf dist && rollup -c rollup.config.ts",
    "lint": "eslint '{src,apps,packages}/**/*.{ts,tsx,js,jsx,vue}'",
    "lint:fix": "eslint '{src,apps,packages}/**/*.{ts,tsx,js,jsx,vue}' --fix",
    "lint:error": "eslint '{src,apps,packages}/**/*.{ts,tsx,js,jsx,vue}' --quiet",
    "lint:spell": "cspell lint '{src,apps,packages}/**/*.{js,ts,jsx,tsx,mjs,cjs,json,css,less,scss,vue,html,md}'",
    "fmt": "oxfmt '{src,apps,packages}/**/*.*'",
    "fmt:check": "oxfmt --check '{src,apps,packages}/**/*.*'",
    "check": "pnpm exec tsc --noEmit && pnpm run lint && pnpm run fmt:check && pnpm run lint:spell",
    "fix": "pnpm run lint:fix && pnpm run fmt",
    "test": "vitest --run",
    "preinstall": "node scripts/sync-node-version/index.js",
    "prepare": "pnpm exec simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint-react/eslint-plugin": "^5.8.19",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@swc/core": "^1.15.40",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "cspell": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.50.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.3",
    "rolldown-plugin-css": "^0.2.11",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-swc3": "^0.12.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.4.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.15.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
