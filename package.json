{
  "name": "tonar",
  "version": "0.0.1-canary",
  "private": true,
  "description": "Tonar: A TypeScript-first ESM monorepo for framework-agnostic utilities plus React and Vue UI toolkits.",
  "bugs": "https://github.com/sonion028/gonar/issues",
  "license": "MIT",
  "author": "sonion",
  "repository": "https://github.com/sonion028/gonar",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clear": "pnpm -r exec rimraf {node_modules,dist,.turbo} && pnpm exec rimraf {node_modules,dist,.turbo}",
    "typecheck": "turbo run typecheck",
    "lint": "eslint '{apps,packages}/**/*.{ts,tsx,js,jsx,vue}'",
    "lint:fix": "eslint '{apps,packages}/**/*.{ts,tsx,js,jsx,vue}' --fix",
    "lint:error": "eslint '{apps,packages}/**/*.{ts,tsx,js,jsx,vue}' --quiet",
    "cspell": "cspell lint '{apps,packages}/**/*.{js,ts,jsx,tsx,mjs,cjs,json,css,less,scss,vue,html,md}'",
    "fmt": "oxfmt '{apps,packages}/**/*.*'",
    "fmt:check": "oxfmt --check '{apps,packages}/**/*.*'",
    "check": "turbo run typecheck && pnpm run lint && pnpm run fmt:check && pnpm run cspell",
    "fix": "pnpm run lint:fix && pnpm run fmt",
    "preinstall": "pnpm exec sync-node-version",
    "postinstall": "pnpm -r exec rimraf .node-version && pnpm -r --filter './{apps,packages}/*' pkg delete engines",
    "prepare": "pnpm exec simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint-react/eslint-plugin": "^5.10.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@vue/eslint-config-typescript": "^14.9.0",
    "cspell": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.50.0",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "sync-node-version": "^0.1.0",
    "turbo": "^2.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.15.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
