{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**"],
  "overrides": [
    {
      "files": ["**/*.{ts,tsx,js,jsx,vue}"],
      "rules": {
        "no-case-declarations": "deny",
        "no-empty": "deny",
        "no-fallthrough": "deny",
        "no-prototype-builtins": "deny",
        "no-redeclare": "deny",
        "no-regex-spaces": "deny",
        "no-unexpected-multiline": "allow",
        "no-unused-vars": "warn",
        "preserve-caught-error": "deny",
        "require-yield": "deny",
        "use-isnan": "deny",
        "valid-typeof": "deny",
        "no-array-constructor": "deny",
        "no-unused-expressions": "allow",
        "typescript/ban-ts-comment": "deny",
        "typescript/no-duplicate-enum-values": "deny",
        "typescript/no-empty-object-type": "deny",
        "typescript/no-explicit-any": "deny",
        "typescript/no-extra-non-null-assertion": "deny",
        "typescript/no-misused-new": "deny",
        "typescript/no-namespace": "deny",
        "typescript/no-non-null-asserted-optional-chain": "deny",
        "typescript/no-require-imports": "deny",
        "typescript/no-this-alias": "deny",
        "typescript/no-unnecessary-type-constraint": "deny",
        "typescript/no-unsafe-declaration-merging": "deny",
        "typescript/no-unsafe-function-type": "deny",
        "typescript/no-wrapper-object-types": "deny",
        "typescript/prefer-as-const": "deny",
        "typescript/prefer-namespace-keyword": "deny",
        "typescript/triple-slash-reference": "deny",
        "jsdoc/check-access": "warn",
        "jsdoc/check-property-names": "warn",
        "jsdoc/check-tag-names": "warn",
        "jsdoc/empty-tags": "warn",
        "jsdoc/implements-on-classes": "warn",
        "jsdoc/no-defaults": "warn",
        "jsdoc/require-param": "warn",
        "jsdoc/require-param-description": "warn",
        "jsdoc/require-param-name": "warn",
        "jsdoc/require-param-type": "allow",
        "jsdoc/require-property": "warn",
        "jsdoc/require-property-description": "warn",
        "jsdoc/require-property-name": "warn",
        "jsdoc/require-property-type": "warn",
        "jsdoc/require-returns": "allow",
        "jsdoc/require-returns-description": "warn",
        "jsdoc/require-returns-type": "allow",
        "jsdoc/require-throws-description": "allow",
        "jsdoc/require-throws-type": "warn",
        "jsdoc/require-yields": "warn",
        "jsdoc/require-yields-description": "allow",
        "jsdoc/require-yields-type": "warn",
        "curly": "allow",
        "unicorn/empty-brace-spaces": "allow",
        "unicorn/no-nested-ternary": "allow",
        "unicorn/number-literal-case": "allow",
        "vue/no-arrow-functions-in-watch": "deny",
        "vue/no-async-in-computed-properties": "deny",
        "vue/no-computed-properties-in-data": "deny",
        "vue/no-deprecated-data-object-declaration": "deny",
        "vue/no-deprecated-delete-set": "deny",
        "vue/no-deprecated-destroyed-lifecycle": "deny",
        "vue/no-deprecated-events-api": "deny",
        "vue/no-deprecated-model-definition": "deny",
        "vue/no-deprecated-props-default-this": "deny",
        "vue/no-deprecated-vue-config-keycodes": "deny",
        "vue/no-dupe-keys": "deny",
        "vue/no-export-in-script-setup": "deny",
        "vue/no-expose-after-await": "deny",
        "vue/no-lifecycle-after-await": "deny",
        "vue/no-reserved-component-names": "deny",
        "vue/no-reserved-keys": "deny",
        "vue/no-reserved-props": "deny",
        "vue/no-shared-component-data": "deny",
        "vue/no-side-effects-in-computed-properties": "deny",
        "vue/no-watch-after-await": "deny",
        "vue/prefer-import-from-vue": "deny",
        "vue/require-prop-type-constructor": "deny",
        "vue/require-render-return": "deny",
        "vue/require-slots-as-functions": "deny",
        "vue/return-in-computed-property": "deny",
        "vue/return-in-emits-validator": "deny",
        "vue/valid-define-emits": "deny",
        "vue/valid-define-options": "deny",
        "vue/valid-define-props": "deny",
        "vue/valid-next-tick": "deny",
        "vue/component-definition-name-casing": "warn",
        "vue/prop-name-casing": "warn",
        "vue/require-default-prop": "warn",
        "vue/require-prop-types": "warn",
        "vue/no-multiple-slot-args": "warn",
        "vue/no-required-prop-with-default": "warn"
      },
      "plugins": ["typescript", "jsdoc", "unicorn", "vue"],
      "env": {
        "es2020": true,
        "browser": true
      }
    },
    {
      "files": ["packages/react-kit/**/*.{ts,tsx,js,jsx}"],
      "rules": {
        "react/only-export-components": [
          "error",
          {
            "allowConstantExport": true
          }
        ]
      },
      "plugins": ["react"]
    }
  ]
}
